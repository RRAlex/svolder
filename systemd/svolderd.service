[Unit]
Description=svolder Forkbeard daemon
Requires=svolderd.socket
After=svolderd.socket bluetooth.target
StartLimitIntervalSec=0

[Service]
ExecStart=__BINDIR__/svolderd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# The daemon's stop takes up to 51 s in the worst case (docs/design/jobs.md); the unit does not
# lean on the manager's default.
TimeoutStopSec=60
# Sandbox: system-call and socket restrictions; see docs/usage/daemon.md. The file system
# restrictions are the opt-in drop-in svolderd-filesystem.conf.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=default.target
