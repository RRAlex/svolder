# The container `make static` builds the release binaries in: the musl target of the platform
# it is built for (x86_64 or aarch64, the base image is multi-arch) with libdbus built in, so
# one binary runs on any Linux of that architecture with no shared library beyond the kernel's
# interface. musl-tools gives the C compiler the bundled libdbus is built with.
# rpm and file give rpmbuild for `make packages`; dpkg-deb comes with the base image.
# cargo-about writes THIRD-PARTY-LICENSES, pinned here so the file depends only on Cargo.lock.
# The base image is pinned by digest and the build tools by an Ubuntu archive snapshot, so the
# compiler that builds libdbus is the same on every build; moving either is a deliberate edit.
# ca-certificates comes from the live archive first: the snapshot is served over HTTPS.
# Builds run as the caller's uid, so the toolchain is world-readable and CARGO_HOME is set
# per run to a writable path.
FROM ubuntu:26.04@sha256:f3d28607ddd78734bb7f71f117f3c6706c666b8b76cbff7c9ff6e5718d46ff64
ARG RUST_VERSION=1.93.1
ARG SNAPSHOT=20261002T000000Z
ARG CARGO_ABOUT_VERSION=0.9.2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && apt-get update --snapshot ${SNAPSHOT} \
 && apt-get install -y --no-install-recommends --snapshot ${SNAPSHOT} curl build-essential musl-tools rpm file \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain ${RUST_VERSION} --target "$(uname -m)-unknown-linux-musl" \
 && cargo install --locked cargo-about --version ${CARGO_ABOUT_VERSION} --features cli \
 && rm -rf /opt/cargo/registry /opt/cargo/git \
 && chmod -R a+rX /opt/rustup /opt/cargo
